//				  | when (i==10) diez -> bebida -> MAQUINA).

// El range va de 0..30 porque el rango más alto que puede haber es 10 + 20

range T = 0..30

MAQUINA = MAQUINA[0],
MAQUINA[i:T] = ( when (i<15) moneda -> ( [5] -> MAQUINA[i+5]
				  					   | [10] -> MAQUINA[i+10]
									   | [20] -> MAQUINA[i+20])
			   | when (i==15) bebida -> MAQUINA[0]
			   | when (i>15) vuelto[i-15] -> bebida -> MAQUINA[0]).
			   
