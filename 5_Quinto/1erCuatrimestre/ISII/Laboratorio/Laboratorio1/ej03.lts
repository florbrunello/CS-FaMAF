// Ejercicio 3

MEETING = ( hello -> converse -> goodbye -> STOP ). 

JOB = ( arrive -> work -> leave -> JOB ). 

MOVIE = ( ahead -> ( left -> STOP
				   | right -> MOVIE )). 

GAME = ( tree -> lose -> GAME
	   | {one,two} -> WIN ), 
WIN = ( win -> GAME ).

// Hace tres flechas en vez de juntar one y two
// GAME = ( tree -> lose -> GAME
//	      | one -> win -> GAME
// 		  | two -> win -> GAME). 

FOURTICK(N = 4) = FOURTICK[0],
FOURTICK[i:0..N] =
  (when(i<N) tick -> FOURTICK[i + 1]).

// FOURTICK = ( tick -> tick -> tick -> tick -> STOP ). 

DOUBLE = (in[i:1..3] -> out[i] -> DOUBLE).

// DOUBLE = (in[i:1..3] -> out[i:1..3] -> DOUBLE). NO anda

PERSON = ( weekend -> sleep -> work -> PERSON
         | weekend -> sleep -> {play,shop} -> PERSON).

